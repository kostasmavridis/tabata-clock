# Gradle wrapper JAR — binary, regenerated by CI via `gradle wrapper` bootstrap step
!gradle/wrapper/gradle-wrapper.jar
gradle/wrapper/gradle-wrapper.jar

# Standard Android / Gradle ignores
*.iml
.gradle/
local.properties
/.idea/
.DS_Store
/build/
app/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# Generated sound files — created at build time by scripts/generate_sounds.py
app/src/main/res/raw/*.wav
app/src/main/res/raw/*.mp3
app/src/main/res/raw/*.ogg
