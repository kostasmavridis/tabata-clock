<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only manifest overlay.
    Declares the FileProvider used by LogExporter to share logcat output
    without requiring WRITE_EXTERNAL_STORAGE. This block is NOT merged into
    release builds, so it cannot accidentally appear in production.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.debug.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_file_provider_paths" />
        </provider>
    </application>

</manifest>
