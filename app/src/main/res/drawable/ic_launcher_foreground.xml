<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a white stopwatch / timer icon centred on the
  adaptive icon canvas (108dp × 108dp, safe zone 72dp × 72dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,20
            a34,34 0 1 1 -0.001,0
            Z
            M54,26
            a28,28 0 1 0 0.001,0
            Z" />

    <!-- Crown / button at top -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,20 h8 v-5 a4,4 0 0 0 -8,0 Z" />

    <!-- Minute hand -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52.5,54 L52.5,34 a1.5,1.5 0 0 1 3,0 L55.5,54 Z" />

    <!-- Hour hand -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 L66,62 a1.5,1.5 0 0 1 -1.5,2.6 L54,57 Z" />

    <!-- Centre dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,51 a3,3 0 1 1 -0.001,0 Z" />
</vector>
