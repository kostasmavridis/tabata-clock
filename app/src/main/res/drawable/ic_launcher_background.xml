<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: deep navy radial gradient matching the
  app's TimerScreen background palette (#0D1B2A → #050D14).
  The gradient gives a subtle depth that contrasts the bright arc
  foreground on modern launchers that support adaptive icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base fill: darkest navy -->
    <path
        android:fillColor="#FF050D14"
        android:pathData="M0,0 H108 V108 H0 Z" />

    <!-- Radial centre glow: slightly lighter navy -->
    <path
        android:fillColor="#33152438"
        android:pathData="M54,54 m-45,0 a45,45 0 1 0 90,0 a45,45 0 1 0 -90,0 Z" />

    <path
        android:fillColor="#220D1B2A"
        android:pathData="M54,54 m-35,0 a35,35 0 1 0 70,0 a35,35 0 1 0 -70,0 Z" />

</vector>
